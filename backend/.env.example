# Copy these values into your shell environment for local development.
# Use a unique random SECRET_KEY (at least 32 characters) outside local demos.
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
APP_ENV=development
DATABASE_PATH=data/resume_ner.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=12

# Demo accounts are disabled by default. Enable only for local demonstrations,
# and provide non-default passwords before starting the backend.
ENABLE_DEMO_ACCOUNTS=false
DEMO_RECRUITER_EMAIL=recruiter@example.test
DEMO_RECRUITER_PASSWORD=
DEMO_APPLICANT_EMAIL=applicant@example.test
DEMO_APPLICANT_PASSWORD=
